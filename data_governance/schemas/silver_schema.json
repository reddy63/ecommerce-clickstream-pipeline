{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Silver Layer Schema",
  "description": "Schema contract for the Silver layer (deduplicated, enriched with event_time and event_date)",
  "type": "object",
  "required": ["product_id", "category", "price", "event_ts", "event_time", "event_date"],
  "properties": {
    "product_id": {
      "type": "integer",
      "description": "Product ID from Fake Store API",
      "minimum": 1
    },
    "category": {
      "type": "string",
      "description": "Product category"
    },
    "price": {
      "type": "number",
      "description": "Product price in USD",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "description": "Product title"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "rating_rate": {
      "type": "number",
      "description": "Product rating score",
      "minimum": 0,
      "maximum": 5
    },
    "rating_count": {
      "type": "integer",
      "description": "Number of product ratings",
      "minimum": 0
    },
    "event_ts": {
      "type": "integer",
      "description": "Original Unix timestamp",
      "minimum": 0
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "Parsed timestamp from event_ts"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Date extracted from event_time"
    }
  },
  "additionalProperties": false
}
