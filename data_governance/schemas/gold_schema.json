{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gold Layer Schema",
  "description": "Schema contract for the Gold layer (aggregated metrics by category and date)",
  "type": "object",
  "required": ["category", "event_date", "total_events", "total_revenue"],
  "properties": {
    "category": {
      "type": "string",
      "description": "Product category"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Aggregation date"
    },
    "total_events": {
      "type": "integer",
      "description": "Total count of events",
      "minimum": 0
    },
    "total_revenue": {
      "type": "number",
      "description": "Total revenue for the category on this date",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
